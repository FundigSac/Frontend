{
  "name": "fundigsac-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts next.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:a11y": "tsx scripts/a11y-audit.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "site:crawl": "tsx scripts/crawl-static.ts",
    "site:patch": "tsx scripts/patch-mirror.ts",
    "site:capture": "tsx scripts/capture-live.ts",
    "site:audit": "tsx scripts/audit-site.ts",
    "legacy:serve": "serve legacy/mirror --listen tcp://127.0.0.1:4173",
    "legacy:verify": "tsx scripts/verify-mirror.ts",
    "test:e2e": "e2e run",
    "test:e2e:mirror": "e2e run --config e2e.mirror.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.6",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ai": "^7.0.0",
    "axe-core": "^4.14.0",
    "e2e": "^0.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.19.0"
}
