{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-content/types/**/*.ts",
    ".next-content/dev/types/**/*.ts",
    ".next-products/types/**/*.ts",
    ".next-products/dev/types/**/*.ts",
    ".next-catalog/types/**/*.ts",
    ".next-catalog/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".node_modules_failed_install",
    "docs",
    ".legacy-2026-10-08",
    "e2e.config.ts",
    "e2e.mirror.config.ts",
    "prisma.config.ts",
    "qa",
    "scripts",
    "tests"
  ]
}
