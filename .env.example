# Copia este archivo a .env.local (local) o cárgalo como variables de entorno en Vercel. Nunca subas valores reales.

# Inicio de sesión con Google (Google Auth Platform > Clientes > cliente OAuth "Aplicación web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres). Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Origen público del sitio registrado en Google (producción). En local se deja vacío: usa http://localhost:3000
AUTH_URL=

# Asistente FundigIA (opcional: sin clave responde la guía rápida)
ANTHROPIC_API_KEY=
