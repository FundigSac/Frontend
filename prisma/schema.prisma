generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuoteStatus {
  NEW
  IN_REVIEW
  SENT
  CLOSED
}

enum ComplaintStatus {
  RECEIVED
  IN_REVIEW
  ANSWERED
  CLOSED
}

enum MediaRole {
  MAIN
  GALLERY
  DETAIL
  DIMENSIONS
  APPLICATION
  TECHNICAL
  POSTER_3D
  MODEL_3D
  DOCUMENT
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique @db.VarChar(160)
  name      String    @db.VarChar(200)
  parentId  String?   @db.Uuid
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentId])
}

model Product {
  id                       String           @id @default(uuid()) @db.Uuid
  slug                     String           @unique @db.VarChar(200)
  name                     String           @db.VarChar(300)
  summary                  String           @db.Text
  description              String?          @db.Text
  status                   ProductStatus    @default(DRAFT)
  needsTechnicalReview     Boolean          @default(true)
  categoryId               String           @db.Uuid
  category                 Category         @relation(fields: [categoryId], references: [id])
  variants                 ProductVariant[]
  media                    ProductMedia[]
  legacyUrls               LegacyRedirect[]
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([categoryId, status])
  @@index([name])
}

model ProductVariant {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @db.Uuid
  product        Product         @relation(fields: [productId], references: [id])
  sku            String          @unique @db.VarChar(100)
  label          String          @db.VarChar(200)
  dn             String?         @db.VarChar(40)
  diameterMm     Decimal?        @db.Decimal(9, 2)
  pn             String?         @db.VarChar(40)
  sdr            String?         @db.VarChar(40)
  connection     String?         @db.VarChar(120)
  weightKg       Decimal?        @db.Decimal(10, 3)
  needsTechnicalReview Boolean   @default(true)
  prices         Price[]
  inventory      InventoryRecord[]
  quoteItems     QuoteItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([productId])
  @@index([dn, pn, sdr])
}

model Price {
  id             String         @id @default(uuid()) @db.Uuid
  variantId      String         @db.Uuid
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  amount         Decimal        @db.Decimal(12, 2)
  currency       String         @default("PEN") @db.VarChar(3)
  validFrom      DateTime
  validUntil     DateTime?
  sourceDocument String         @db.VarChar(300)
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([variantId, validFrom])
}

model InventoryRecord {
  id         String         @id @default(uuid()) @db.Uuid
  variantId  String         @db.Uuid
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  asOf       DateTime
  source     String         @db.VarChar(300)
  createdAt  DateTime       @default(now())

  @@index([variantId, asOf])
}

model Customer {
  id         String     @id @default(uuid()) @db.Uuid
  company    String     @db.VarChar(250)
  ruc        String?    @db.VarChar(11)
  contact    String     @db.VarChar(200)
  email      String     @db.VarChar(320)
  phone      String     @db.VarChar(50)
  city       String?    @db.VarChar(150)
  quotes     Quote[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([ruc])
  @@index([email])
}

model Quote {
  id          String      @id @default(uuid()) @db.Uuid
  number      String      @unique @db.VarChar(30)
  customerId  String      @db.Uuid
  customer    Customer    @relation(fields: [customerId], references: [id])
  status      QuoteStatus @default(NEW)
  project     String?     @db.Text
  items       QuoteItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, createdAt])
}

model QuoteItem {
  id         String         @id @default(uuid()) @db.Uuid
  quoteId    String         @db.Uuid
  quote      Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variantId  String         @db.Uuid
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  note       String?        @db.Text

  @@index([quoteId])
}

model Complaint {
  id           String          @id @default(uuid()) @db.Uuid
  number       String          @unique @db.VarChar(30)
  claimantName String          @db.VarChar(200)
  claimantEmail String         @db.VarChar(320)
  claimantPhone String?        @db.VarChar(50)
  detail       String          @db.Text
  status       ComplaintStatus @default(RECEIVED)
  receivedAt   DateTime        @default(now())
  answeredAt   DateTime?

  @@index([status, receivedAt])
}

model MediaAsset {
  id         String         @id @default(uuid()) @db.Uuid
  storageKey String         @unique @db.VarChar(500)
  mimeType   String         @db.VarChar(120)
  bytes      Int
  width      Int?
  height     Int?
  alt        String?        @db.VarChar(500)
  products   ProductMedia[]
  createdAt  DateTime       @default(now())
}

model ProductMedia {
  productId String    @db.Uuid
  mediaId   String    @db.Uuid
  role      MediaRole
  position  Int       @default(0)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([productId, role, position])
}

model LegacyRedirect {
  oldPath   String  @id @db.VarChar(500)
  newPath   String  @db.VarChar(500)
  productId String? @db.Uuid
  product   Product? @relation(fields: [productId], references: [id])
}

model AdminUser {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique @db.VarChar(320)
  passwordHash String?     @db.VarChar(255)
  active       Boolean     @default(false)
  roles        AdminRole[]
  auditEvents  AuditEvent[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model AdminRole {
  userId String    @db.Uuid
  role   String    @db.VarChar(60)
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model AuditEvent {
  id         String    @id @default(uuid()) @db.Uuid
  actorId    String    @db.Uuid
  actor      AdminUser @relation(fields: [actorId], references: [id])
  action     String    @db.VarChar(120)
  entityType String    @db.VarChar(120)
  entityId   String    @db.VarChar(100)
  at         DateTime  @default(now())
  detail     Json?

  @@index([entityType, entityId, at])
  @@index([actorId, at])
}
